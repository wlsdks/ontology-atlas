{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": {
    "entry": [
      "next.config.ts",
      "app/**/{page,layout,template,error,loading,not-found,global-error,default,route,icon,apple-icon,opengraph-image,twitter-image,sitemap,robots}.{js,jsx,ts,tsx}",
      "app/**/manifest.{js,ts}"
    ]
  },
  "entry": [
    "src/i18n/navigation.ts",
    "src/i18n/routing.ts",
    "tests/contract/**/*.test.ts",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "app/**/*.{ts,tsx}"
  ],
  "ignore": [
    "scripts/**"
  ],
  "ignoreExportsUsedInFile": true
}
