{
  "version": 1,
  "servers": {
    "com.notion/mcp": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
      "name": "com.notion/mcp",
      "description": "Official Notion MCP server",
      "repository": {},
      "version": "1.0.1",
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://mcp.notion.com/mcp"
        },
        {
          "type": "sse",
          "url": "https://mcp.notion.com/sse"
        }
      ]
    },
    "io.github.github/github-mcp-server": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.github.github/github-mcp-server",
      "description": "Connect AI assistants to GitHub - manage repos, issues, PRs, and workflows through natural language.",
      "title": "GitHub",
      "repository": {
        "url": "https://github.com/github/github-mcp-server",
        "source": "github"
      },
      "version": "1.3.0",
      "packages": [
        {
          "registryType": "oci",
          "identifier": "ghcr.io/github/github-mcp-server:1.3.0",
          "transport": {
            "type": "stdio"
          },
          "runtimeArguments": [
            {
              "description": "Set an environment variable in the runtime",
              "isRequired": true,
              "value": "GITHUB_PERSONAL_ACCESS_TOKEN={token}",
              "variables": {
                "token": {
                  "isRequired": true,
                  "format": "string",
                  "isSecret": true
                }
              },
              "type": "named",
              "name": "-e"
            }
          ]
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": [
            {
              "description": "Authorization header with authentication token (PAT or App token)",
              "isSecret": true,
              "name": "Authorization"
            }
          ]
        }
      ]
    },
    "io.github.microsoft/playwright-mcp": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.github.microsoft/playwright-mcp",
      "description": "Playwright Tools for MCP",
      "repository": {
        "url": "https://github.com/microsoft/playwright-mcp",
        "source": "github"
      },
      "version": "0.0.80",
      "packages": [
        {
          "registryType": "npm",
          "identifier": "@playwright/mcp",
          "version": "0.0.80",
          "transport": {
            "type": "stdio"
          }
        }
      ]
    },
    "io.github.upstash/context7": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.github.upstash/context7",
      "description": "Up-to-date code docs for any prompt",
      "title": "Context7",
      "repository": {
        "url": "https://github.com/upstash/context7",
        "source": "github"
      },
      "version": "4.1.0",
      "websiteUrl": "https://context7.com",
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/upstash/context7/master/public/icon.png",
          "mimeType": "image/png"
        }
      ],
      "packages": [
        {
          "registryType": "npm",
          "identifier": "@upstash/context7-mcp",
          "version": "4.1.0",
          "transport": {
            "type": "stdio"
          },
          "environmentVariables": [
            {
              "description": "API key for authentication",
              "isSecret": true,
              "name": "CONTEXT7_API_KEY"
            }
          ]
        },
        {
          "registryType": "mcpb",
          "identifier": "https://github.com/upstash/context7/releases/download/mcpb-v4.1.0/context7.mcpb",
          "version": "4.1.0",
          "fileSha256": "c5483db1abe8a05ec1d83a60c5bbddabe667cda462fcb831a8709580d43bddfa",
          "transport": {
            "type": "stdio"
          },
          "environmentVariables": [
            {
              "description": "API key for authentication",
              "isSecret": true,
              "name": "CONTEXT7_API_KEY"
            }
          ]
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://mcp.context7.com/mcp",
          "headers": [
            {
              "description": "API key for authentication. Accepts \"Bearer <key>\" or the raw key.",
              "isSecret": true,
              "name": "Authorization"
            }
          ]
        }
      ]
    }
  }
}
