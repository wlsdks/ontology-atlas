  "gate": [
    "block-npm-publish",
    "block-unsafe-git",
    "block-manual-landing"
  ],
  "commands": [
    {
      "command": "git status",
      "blockedBy": null
    },
    {
      "command": "pnpm typecheck",
      "blockedBy": null
    },
    {
      "command": "git commit -m \"fix: tidy\"",
      "blockedBy": null
    },
    {
      "command": "git push --force",
      "blockedBy": "block-unsafe-git"
    },
    {
      "command": "pnpm test",
      "blockedBy": null
    },
    {
      "command": "git reset --hard",
      "blockedBy": "block-unsafe-git"
    },
    {
      "command": "git push origin fix/tidy",
      "blockedBy": null
    },
    {
      "command": "npm publish",
      "blockedBy": "block-npm-publish"
    },
    {
      "command": "gh pr merge 42",
      "blockedBy": "block-manual-landing"
    }
  ]
