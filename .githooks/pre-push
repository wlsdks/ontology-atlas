#!/bin/sh
# Fast path-scoped checks run in parallel; required CI owns exhaustive evidence.
# Lane timings are reported, never used as pass/fail criteria.

set -e
started_all=$(date +%s)

# Git exports its own location (GIT_DIR and friends) to hooks. Every lane below
# inherits it, so a test that builds a scratch repository with plain `git init`
# in a temp directory silently committed to, configured, and branched this
# repository instead (2026-09-26: a fixture set user.name, created a branch and
# moved a worktree's HEAD). Resolve the checkout once, then drop the variables;
# every git call here and in the lanes finds the repository from the cwd.
cd "$(git rev-parse --show-toplevel)"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX

BASE_REF="origin/main"
ZERO="0000000000000000000000000000000000000000"
# Reported, not enforced — see the note beside the summary below.
BUDGET_SECONDS=90

# git feeds `<local ref> <local sha> <remote ref> <remote sha>` on stdin.
have_push=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in "$ZERO") continue ;; esac
  case "$local_sha" in
    *[!0-9a-f]*|'') echo '[pre-push] Invalid pushed object id.' >&2; exit 1 ;;
  esac
  if [ "${#local_sha}" -ne 40 ]; then
    echo '[pre-push] Invalid pushed object id.' >&2
    exit 1
  fi
  pushed_commit=$(git rev-parse --verify "$local_sha^{commit}" 2>/dev/null) || {
    echo '[pre-push] The pushed object does not resolve to a commit.' >&2
    exit 1
  }
  if [ "$pushed_commit" != "$(git rev-parse HEAD)" ]; then
    echo '[pre-push] The pushed commit differs from HEAD; run the push from its checkout.' >&2
    exit 1
  fi
  have_push=1
done
# Nothing being pushed (branch deletion, or invoked by hand with no stdin).
[ "$have_push" = "1" ] || exit 0

if ! git diff --quiet HEAD --; then
  echo '[pre-push] Tracked files differ from the pushed HEAD; local checks would inspect different content.' >&2
  exit 1
fi

if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null; then
  echo "[pre-push] Could not resolve $BASE_REF; skipping because the diff scope is unknown."
  exit 0
fi

# Three-dot: what THIS branch changed, ignoring what main moved underneath it.
CHANGED=$(git diff --name-only "$BASE_REF...HEAD" -- 2>/dev/null || true)
[ -n "$CHANGED" ] || exit 0

n_changed=$(printf '%s\n' "$CHANGED" | sed '/^$/d' | wc -l | tr -d ' ')

# `touched <glob>...` — true when the branch changed a file matching any glob.
touched() {
  for pattern in "$@"; do
    if printf '%s\n' "$CHANGED" | grep -qE "$pattern"; then
      return 0
    fi
  done
  return 1
}

TMP=$(mktemp -d)
# shellcheck disable=SC2064
trap "rm -rf '$TMP'" EXIT INT TERM

MERGE_BASE=$(git merge-base "$BASE_REF" HEAD)
node scripts/lib/prepush/fast-checks.mjs "--base=$MERGE_BASE" "--output=$TMP"
UNIT_COMMAND=$(node scripts/ci/prepush-unit-plan.mjs "--base=$MERGE_BASE")

lane_names=""
lane_count=0

# `lane <name> <command>` — record and start one lane in the background.
lane() {
  name=$1
  shift
  lane_count=$((lane_count + 1))
  lane_names="$lane_names $name"
  # `set -e` is deliberately lifted around the lane itself. Inherited into this
  # subshell it aborts at the first non-zero `eval`, so a FAILING lane never reached
  # the lines that record its exit code and its duration — the summary's `|| echo 1`
  # fallback made that look correct and the timing print exposed it as `0s`
  # (measured 2026-09-12). A lane's own result is exactly what must survive its
  # failure.
  ( started=$(date +%s)
    set +e
    eval "$@" >"$TMP/$name.log" 2>&1
    code=$?
    set -e
    echo "$code" >"$TMP/$name.code"
    echo "$(( $(date +%s) - started ))" >"$TMP/$name.secs" ) &
  eval "pid_$name=$!"
}

echo "[pre-push] Selecting parallel lanes from $n_changed files changed on this branch."

TS='\.tsx?$|\.mjs$|tsconfig.*\.json$|next\.config\.ts$'
APP='^src/|^app/'
DOCS='^docs/|^[A-Z0-9_-]+\.md$|^\.claude/|^\.agents/'

# Materialize once before parallel readers; derived output is never staged.
if touched '^docs/|^samples/storefront/|^scripts/(docs-vault/build-docs-vault|lib/(records/record-ledgers|records/po-pilot-records|parse-frontmatter))'; then
  pnpm docs-vault:build || exit 1
fi

touched "$TS" "$APP" && lane typecheck 'pnpm exec tsc --noEmit'
# ESLint is per-file, so linting the whole tree to judge one changed file costs
# 84.9 s to learn what a few seconds can say (measured 2026-09-12). A configuration
# change is the exception — it can move every file's verdict — and still lints
# everything. CI's `Types · Lint · Docs` runs the repo-wide pass on every PR either
# way, so nothing is lost, only moved off the push.
if touched '^eslint\.config\.mjs$'; then
  lane lint 'pnpm lint'
elif [ -s "$TMP/lint-files" ]; then
  lane lint "xargs -0 pnpm exec eslint --max-warnings=0 --no-warn-ignored -- <'$TMP/lint-files'"
fi
if [ -s "$TMP/node-files" ]; then
  lane scripts "xargs -0 pnpm exec node --test -- <'$TMP/node-files'"
fi
if [ -f "$TMP/docs-registry" ]; then
  lane docs_registry 'pnpm dev-checks:check'
fi
if [ -f "$TMP/workflows" ]; then
  lane workflows 'pnpm exec vitest run tests/contract/security/workflow-security.contract.test.ts tests/contract/security/github-action-pins.contract.test.ts'
fi
# The import graph selects unit files once; performance and full contract suites stay in CI.
if [ -n "$UNIT_COMMAND" ] && [ "$UNIT_COMMAND" != ':' ]; then
  if ! touched '^messages/' && node scripts/lib/ci/focused-checks-proof.mjs --covers="$MERGE_BASE"; then
    echo '[pre-push] unit: every change since the merge base passed checks:changed --run on this exact content; skipped (CI reruns it)'
  else
    lane unit "$UNIT_COMMAND"
  fi
fi
touched '^messages/|^scripts/i18n/validate-messages' && lane i18n 'pnpm test:i18n:messages'
# The lane selector covers agents:check's full subject set: `.codex/**` (the
# hook/config mirror and the MCP-grant denominator via .codex/config.toml),
# `.mcp.json` (the other grant denominator), and every nested AGENTS.md (an
# input of the 32 KiB cap — root plus the largest nested file). With the
# narrower glob, growing a nested AGENTS.md past the cap passed pre-push
# silently and only CI's unconditional agents:check caught it (bug sweep
# 2026-09-01 — the same half-subject-set failure noted here on 2026-08-24).
touched '^AGENTS\.md$|^CLAUDE\.md$|^\.claude/|^\.agents/|^\.codex/|^\.mcp\.json$|(^|/)AGENTS\.md$' && lane agents 'pnpm agents:check'
touched "$DOCS" '^src/entities/docs-vault/data/' && lane docs 'pnpm docs:language && pnpm docs:links'
# The gateway shows one vault file verbatim; the committed copy must match the vault.
touched '^docs/ontology/' '^scripts/download/generate-evidence-specimen' '^src/views/download/model/evidence-specimen' && lane specimen 'pnpm gateway:specimen:check'
touched '^mcp/|^cli/' && lane mcp 'pnpm docs:surface:check'
touched '^(mcp/)?(package\.json|pnpm-lock\.yaml)$' '^src-tauri/Cargo\.(toml|lock)$' '^scripts/licenses/(check-licenses|build-notice)' '^scripts/lib/licenses/(license-policy|third-party-|attribution-marker)' '^scripts/data/license-exceptions\.json$' '^NOTICE\.md$' '^public/third-party-licenses\.txt$' && lane licenses 'pnpm licenses:check && pnpm notice:check'
# The design system's table of contents is generated from its own headings, and only this file
# can move it. It was missing here: a section added on 2026-08-28 shipped with a stale contents
# list through thirteen green lanes, because `docs:check` runs this check and the docs lane
# above runs three of its five parts.
touched '^docs/DESIGN-SYSTEM\.md$' && lane design_toc 'pnpm design:toc:check'

# Reuse the scanner's actual source classifier; a failed scope read runs broadly.
SOURCE_CHANGED=$(node --input-type=module -e '
  import { execFileSync } from "node:child_process";
  import { isSupportedSourcePath } from "./scripts/quality/source-language/source-paths.mjs";
  const paths = execFileSync("git", ["diff", "--name-only", "-z", process.argv[1]], { encoding: "utf8" }).split("\0").filter(Boolean);
  console.log(paths.some(isSupportedSourcePath) ? "yes" : "no");
' "$BASE_REF...HEAD" || true)
if [ "$SOURCE_CHANGED" != "no" ] || touched '^scripts/quality/source-language/|^package\.json$'; then
  lane source_language 'pnpm source:language'
fi
# A citation can break when its source or its Markdown target changes.
if [ "$SOURCE_CHANGED" != "no" ] || touched '\.md$'; then
  lane comment_refs 'node scripts/docs/check-comment-refs.mjs'
fi
# Full contract and Knip evidence is owned by the impact-planned PR CI.
lane decisions 'pnpm decisions:check'

echo "[pre-push] Running $lane_count lanes:$lane_names"
wait
total=$(( $(date +%s) - started_all ))

failed=""
slowest_name=""
slowest_secs=0
for name in $lane_names; do
  code=$(cat "$TMP/$name.code" 2>/dev/null || echo 1)
  secs=$(cat "$TMP/$name.secs" 2>/dev/null || echo 0)
  if [ "$secs" -gt "$slowest_secs" ]; then
    slowest_secs=$secs
    slowest_name=$name
  fi
  if [ "$code" = "0" ]; then
    printf '  ok    %-16s %3ss\n' "$name" "$secs"
  else
    printf '  FAIL  %-16s %3ss\n' "$name" "$secs"
    failed="$failed $name"
  fi
done

if [ -n "$failed" ]; then
  for name in $failed; do
    echo ""
    echo "──────── $name ────────"
    tail -40 "$TMP/$name.log"
  done
  echo ""
  echo "[pre-push] Local CI mirrors failed:$failed"
  echo "[pre-push] Fix them and push again; this is cheaper than spending eight CI minutes."
  echo ""
  exit 1
fi

# The budget is reported, never enforced. A hook that refused a green push because
# the machine was slow would be the very thing `.claude/rules/testing.md` forbids —
# a gate on the clock. What this line buys is that the cost cannot creep unseen:
# 367 s was the measured wall time for a one-file change on 2026-09-12, and nobody
# knew, because nothing printed it.
if [ "$total" -gt "$BUDGET_SECONDS" ]; then
  echo "[pre-push] All local lanes passed in ${total}s — over the ${BUDGET_SECONDS}s budget, slowest lane '$slowest_name' at ${slowest_secs}s."
  echo "[pre-push] If that lane is now the wrong shape, fix the lane; see docs/DEVELOPMENT-CHECKS.md, \"Lane budgets\"."
else
  echo "[pre-push] All local lanes passed in ${total}s (budget ${BUDGET_SECONDS}s, slowest '$slowest_name' at ${slowest_secs}s)."
fi
echo "[pre-push] CI owns the parallel e2e shards and the repo-wide lint pass."
