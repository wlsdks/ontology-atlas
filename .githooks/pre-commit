#!/bin/sh
# 생성물 신선도 — 커밋 자리에서 잡는다 (2026-08-02)
#
# 이 저장소는 볼트 문서를 고치고 `pnpm docs-vault:build` 를 빠뜨리는 실패를
# 이틀에 세 번 냈다(#826 · #828 · #831). 셋 다 도구 문제가 아니었다 —
# `pnpm checks:changed` 는 매번 `pnpm docs-vault:check` 를 정확히 지목했고,
# 아무도 안 돌렸을 뿐이다. **기억에 의존하는 규율은 세 번 이상 반복되면
# 규율이 아니라 사고 대기열이다.**
#
# 그래서 판정을 8분 뒤 CI 에서 0.5초 뒤 커밋으로 옮긴다. 고치지는 않는다 —
# 스테이지된 내용을 훅이 말없이 바꾸면 사람이 안 쓴 바이트가 사람 이름으로
# 커밋된다. 막고, 정확한 명령을 말한다.
#
# ⚠️ **인덱스를 잰다, 작업본이 아니라.** 이 훅의 첫 판은 작업본에서
# `--check` 를 돌렸고, 그래서 **자기 자신을 담은 PR 을 통과시켰다**: 재생성은
# 했는데 산출물을 스테이지하지 않은 커밋이었고, 작업본은 깨끗했으므로 훅은
# 초록을 봤다. CI 는 커밋된 트리를 보므로 빨개졌다. 커밋이 남기는 것은
# 인덱스이니 인덱스를 재는 것이 옳다 — `git checkout-index` 로 인덱스를
# 그대로 펼쳐 거기서 검사한다(실측 0.65초).
#
# 우회는 `--no-verify` 인데 그건 `.claude/rules/git.md` 가 금지한다.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# 입력(볼트 마크다운)이든 산출물이든 손댔으면 본다 — 산출물만 손으로 고치는
# 경우도 같은 게이트가 잡아야 한다.
if ! printf '%s\n' "$staged" | grep -qE '^(docs/.*\.md|samples/storefront/.*\.md|src/entities/docs-vault/data/|public/docs-vault/)'; then
  exit 0
fi

staging_tree=$(mktemp -d)
trap 'rm -rf "$staging_tree"' EXIT INT TERM

git checkout-index -a --prefix="$staging_tree/"

# 재생성기는 문서 날짜를 `git log` 에서 읽는다. 인덱스 사본에는 `.git` 이
# 없으므로 그대로 두면 매 커밋마다 `fatal: not a git repository` 가 두 줄씩
# 뜨고, 날짜는 전부 오늘로 붕괴한다(실측: 150개 문서 전부 오늘).
#
# 판정 자체는 그래도 옳다 — `comparableManifest` 가 `updatedAt`/`generatedAt`
# 을 비교에서 제외한다. 그래도 진짜 저장소를 가리켜 준다: **읽어서 무해한
# 에러가 매번 뜨는 게이트는 다음 사람이 무시하는 법을 배우는 게이트다.**
GIT_DIR=$(git rev-parse --absolute-git-dir)
GIT_WORK_TREE=$(git rev-parse --show-toplevel)
export GIT_DIR GIT_WORK_TREE

if ! (cd "$staging_tree" && node scripts/build-docs-vault.mjs --check); then
  echo ""
  echo "[pre-commit] 볼트 생성물이 입력과 어긋난 채 커밋되려 했다."
  echo "[pre-commit] (작업본이 아니라 **스테이지된 내용**을 잰 결과다.)"
  echo "[pre-commit] 고치고 다시 커밋해라:"
  echo ""
  echo "    pnpm docs-vault:build && git add src/entities/docs-vault/data public/docs-vault"
  echo ""
  exit 1
fi
