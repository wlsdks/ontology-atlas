#!/bin/sh
# Artifact freshness — catch it at the commit site (2026-08-02)
#
# This repo caused failures by fixing vault docs and omitting `pnpm docs-vault:build`
# three times in two days (#826 · #828 · #831). None were tool issues —
# `pnpm checks:changed` always precisely pointed to `pnpm docs-vault:check`,
# and nobody ran it. **Discipline relying on memory, if repeated more than three times,
# is not discipline but an incident queue.**
#
# So we move the judgment from CI 8 minutes later to commit-time 0.5 seconds later. We don't fix it —
# if the hook silently changes staged content, bytes the person didn't write get committed
# under their name. Block it, and state the exact command.
#
# ⚠️ **Measure the index, not the working tree.** The first version of this hook ran
# `--check` on the working tree, so **it passed a PR containing itself**: regeneration
# happened but the output wasn't staged, and since the working tree was clean, the hook
# saw green. CI sees the committed tree, so it turned red. What a commit leaves is
# the index, so measuring the index is correct — `git checkout-index` expands the index
# as-is and inspects there (measured 0.65s).
#
# Bypassing is `--no-verify`, which `.claude/rules/git.md` prohibits.

set -e

# Deletions included (D): removing a vault doc changes the manifest, tree,
# backlinks, and public copies just as surely as editing one — with ACMR only,
# a deletion-only commit skipped this gate entirely and committed stale
# generated output, deferring the catch from this hook's half-second to the
# pre-push lane's minutes (bug sweep 2026-09-01). The checkout-index snapshot
# below expands the index as-is, so a deleted file is simply absent from it.
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0

# If touched, inspect whether input (Vault markdown) or output — even if only
# manually fixing outputs requires the same gate.
if ! printf '%s\n' "$staged" | grep -qE '^(docs/.*\.md|samples/storefront/.*\.md|src/entities/docs-vault/data/|public/docs-vault/)'; then
  exit 0
fi

staging_tree=$(mktemp -d)
trap 'rm -rf "$staging_tree"' EXIT INT TERM

git checkout-index -a --prefix="$staging_tree/"

# The regenerator reads document dates from `git log`. Since index copies lack `.git`,
# leaving them as-is causes two lines of `fatal: not a git repository` per commit,
# collapsing all dates to today (actual: all 150 docs show today).
#
# The verdict itself remains correct — `comparableManifest` excludes `updatedAt`/`generatedAt`
# from comparison. Still, point to the real repo: **a gate that throws harmless errors
# every time teaches the next person to ignore it.**
GIT_DIR=$(git rev-parse --absolute-git-dir)
GIT_WORK_TREE=$(git rev-parse --show-toplevel)
export GIT_DIR GIT_WORK_TREE

if ! (cd "$staging_tree" && node scripts/build-docs-vault.mjs --check); then
  echo ""
  echo "[pre-commit] vault artifacts do not match their inputs."
  echo "[pre-commit] (This result measures the staged content, not the working tree.)"
  echo "[pre-commit] Regenerate, stage, and commit again:"
  echo ""
  echo "    pnpm docs-vault:build && git add src/entities/docs-vault/data public/docs-vault"
  echo ""
  exit 1
fi
