{
  "serverName": "ontology-atlas-mcp",
  "serverVersion": "2.7.15",
  "toolInventoryPlaceholder": "__ONTOLOGY_ATLAS_ACTIVE_TOOL_INVENTORY__",
  "readTools": [
    "connection_info",
    "git_status",
    "git_history",
    "list_concepts",
    "list_constellations",
    "get_constellation",
    "get_concept",
    "get_concepts",
    "find_evidence",
    "find_backlinks",
    "find_neighbors",
    "find_path",
    "list_kinds",
    "find_orphans",
    "query_concepts",
    "compile_ontology",
    "query_ontology",
    "validate_vault",
    "validate_wiki",
    "read_source",
    "inspect_architecture",
    "analyze_repo_structure",
    "infer_imports",
    "index_project"
  ],
  "retiredTools": [
    {
      "name": "get_concept",
      "replacement": "get_concepts({ slugs: [slug] })"
    },
    {
      "name": "add_concept",
      "replacement": "add_concepts({ concepts: [row] })"
    },
    {
      "name": "add_relation",
      "replacement": "add_relations({ relations: [row] })"
    },
    {
      "name": "find_path",
      "replacement": "query_ontology({ operation: 'path', from, to })"
    },
    {
      "name": "find_neighbors",
      "replacement": "query_ontology({ operation: 'neighbors', slug, includeUnresolved: true })"
    },
    {
      "name": "list_kinds",
      "replacement": "list_concepts({ limit: 1 }) and read its census"
    },
    {
      "name": "index_project",
      "replacement": "analyze_repo_structure, then infer_imports and validate_vault"
    }
  ],
  "constructionTools": [
    "connection_info",
    "list_concepts",
    "get_concepts",
    "find_evidence",
