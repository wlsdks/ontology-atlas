{
  "serverName": "ontology-atlas-mcp",
  "serverVersion": "2.7.15",
  "readTools": [
    "connection_info",
    "list_concepts",
    "get_constellation",
    "get_concept",
    "get_concepts",
    "find_backlinks",
    "find_neighbors",
    "find_path",
    "list_kinds",
    "compile_ontology",
    "query_ontology",
    "validate_vault",
    "validate_wiki",
    "read_source",
    "inspect_architecture",
    "analyze_repo_structure",
    "infer_imports"
  ],
  "retiredTools": [
    {
      "name": "get_concept",
      "replacement": "get_concepts({ slugs: [slug] })"
    },
    {
      "name": "add_concept",
      "replacement": "add_concepts({ concepts: [row] })"
    },
    {
      "name": "add_relation",
      "replacement": "add_relations({ relations: [row] })"
    },
    {
      "name": "find_path",
      "replacement": "query_ontology({ operation: 'path', from, to })"
    },
    {
      "name": "find_neighbors",
      "replacement": "query_ontology({ operation: 'neighbors', slug, includeUnresolved: true })"
    },
    {
      "name": "list_kinds",
      "replacement": "list_concepts({ limit: 1 }) and read its census"
    },
    {
      "name": "index_project",
      "replacement": "analyze_repo_structure, then infer_imports and validate_vault"
    },
    {
      "name": "git_status",
      "replacement": "your own git: `git -C <repoRoot> status -- <vault>` (`connection_info` names both paths)"
    },
    {
      "name": "git_history",
      "replacement": "your own git: `git -C <repoRoot> log -- <vault>`"
    },
    {
      "name": "git_snapshot",
      "replacement": "your own git: `git -C <vaultRoot> add -- . && git -C <vaultRoot> commit -m \"<why>\" -- .`, not during a merge or rebase, and never push"
    },
    {
      "name": "list_constellations",
      "replacement": "get_constellation with no `id`"
    },
    {
      "name": "find_evidence",
      "replacement": "list_concepts({ mentions: \"text\" })"
    },
    {
      "name": "find_orphans",
      "replacement": "query_ontology({ operation: 'match_nodes', hasIncoming: false })"
    },
    {
      "name": "query_concepts",
      "replacement": "list_concepts({ filter })"
    },
    {
      "name": "replace_relation",
      "replacement": "remove_relation({ from, to, type, replaceWith: { to, type, why }, confirm })"
    },
    {
      "name": "reclassify_concept",
      "replacement": "rename_concept({ oldSlug, newKind, domain, body, confirm })"
    }
  ],
  "constructionTools": [
    "connection_info",
    "list_concepts",
    "get_concepts",
    "finalize_project_meaning",
    "connect_project_source",
    "add_concepts",
    "add_relations",
    "patch_concept",
    "find_backlinks",
    "compile_ontology",
    "query_ontology",
    "validate_vault",
    "read_source",
    "infer_imports",
    "analyze_repo_structure"
  ],
  "topLevelNonBlankArguments": {
    "list_concepts": [
      "domain",
      "mentions",
      "filter"
    ],
    "get_concept": [
      "slug"
    ],
    "finalize_project_meaning": [
      "projectSlug"
    ],
    "connect_project_source": [
      "projectSlug",
      "rootPath"
    ],
    "disconnect_project_source": [
      "projectSlug"
    ],
    "add_concept": [
      "slug",
      "title",
      "domain",
      "path"
    ],
    "add_relation": [
      "from",
      "to"
    ],
    "remove_relation": [
      "from",
      "to"
    ],
    "patch_concept": [
      "slug"
    ],
    "find_backlinks": [
      "slug"
    ],
    "find_neighbors": [
      "slug"
    ],
    "find_path": [
      "from",
      "to"
    ],
    "query_ontology": [
      "recordId",
      "slug",
      "candidateSlug",
      "title",
      "from",
      "to",
      "project",
      "domain",
      "afterActionId"
    ],
    "validate_vault": [
      "repoRoot"
    ],
    "read_source": [
      "path"
    ],
    "inspect_architecture": [
      "rootPath",
      "profileSlug"
    ],
    "infer_imports": [
      "rootPath",
      "afterReviewId",
      "focusPath",
      "focusAfterEdgeId"
    ],
    "analyze_repo_structure": [
      "rootPath"
    ],
    "rename_concept": [
      "oldSlug",
      "newSlug"
    ],
    "merge_concepts": [
      "fromSlug",
      "intoSlug"
    ],
    "delete_concept": [
      "slug"
    ],
    "absorb_document": [
      "filePath"
    ]
  }
}
