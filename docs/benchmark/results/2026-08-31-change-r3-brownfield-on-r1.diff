diff --git a/apps/web/src/acknowledgement.mjs b/apps/web/src/acknowledgement.mjs
index 5255901..9935684 100644
--- a/apps/web/src/acknowledgement.mjs
+++ b/apps/web/src/acknowledgement.mjs
@@ -1,3 +1,6 @@
 export function formatAcknowledgement(record) {
-  return `${record.member} acknowledged \`${record.decision}\``;
+  const acknowledgement = `${record.member} acknowledged \`${record.decision}\``;
+  const note = record.note?.trim();
+
+  return note ? `${acknowledgement} — ${note}` : acknowledgement;
 }
