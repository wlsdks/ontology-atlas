diff --git a/src/checkout.mjs b/src/checkout.mjs
index ac56a9b..0643d7e 100644
--- a/src/checkout.mjs
+++ b/src/checkout.mjs
@@ -1,4 +1,10 @@
-export function confirmPurchase(totalCents, inventoryAvailable) {
+export function confirmPurchase(totalCents, inventoryAvailable, options = {}) {
   if (!inventoryAvailable) throw new Error('inventory unavailable');
-  return totalCents;
+
+  const discountCents = options.discountCents === undefined ? 0 : options.discountCents;
+  if (!Number.isInteger(discountCents) || discountCents < 0) {
+    throw new RangeError('discountCents must be a non-negative integer');
+  }
+
+  return Math.max(0, totalCents - discountCents);
 }
diff --git a/test/checkout.test.mjs b/test/checkout.test.mjs
index 09bc88e..cb1e417 100644
--- a/test/checkout.test.mjs
+++ b/test/checkout.test.mjs
@@ -9,3 +9,25 @@ test('confirms an available purchase at its current total', () => {
 test('refuses a purchase when inventory is unavailable', () => {
   assert.throws(() => confirmPurchase(1200, false), /inventory unavailable/);
 });
+
+test('applies a non-negative integer discount to the confirmed total', () => {
+  assert.equal(confirmPurchase(1200, true, { discountCents: 250 }), 950);
+});
+
+test('does not confirm a negative total when the discount exceeds the total', () => {
+  assert.equal(confirmPurchase(1200, true, { discountCents: 1500 }), 0);
+});
+
+test('rejects a negative discount', () => {
+  assert.throws(
+    () => confirmPurchase(1200, true, { discountCents: -1 }),
+    RangeError,
+  );
+});
+
+test('rejects a non-integer discount', () => {
+  assert.throws(
+    () => confirmPurchase(1200, true, { discountCents: 1.5 }),
+    RangeError,
+  );
+});
