diff --git a/apps/web/src/acknowledgement.mjs b/apps/web/src/acknowledgement.mjs
index 1313b75..73b5dd1 100644
--- a/apps/web/src/acknowledgement.mjs
+++ b/apps/web/src/acknowledgement.mjs
@@ -1,3 +1,6 @@
 export function formatAcknowledgement(record) {
-  return `${record.member} acknowledged \`${record.decision}\`;
+  const acknowledgement = `${record.member} acknowledged \`${record.decision}\``;
+  const note = record.note?.trim();
+
+  return note ? `${acknowledgement}: ${note}` : acknowledgement;
 }
diff --git a/apps/web/test/acknowledgement.test.mjs b/apps/web/test/acknowledgement.test.mjs
index 318a02e..3075662 100644
--- a/apps/web/test/acknowledgement.test.mjs
+++ b/apps/web/test/acknowledgement.test.mjs
@@ -2,9 +2,29 @@ import assert from 'node:assert/strict';
 import test from 'node:test';
 import { formatAcknowledgement } from '../src/acknowledgement.mjs';

-test('formats an acknowledgement for the incident timeline', () => {
+test('formats an acknowledgement with a note for the incident timeline', () => {
+  assert.equal(
+    formatAcknowledgement({
+      member: 'Lee',
+      decision: 'Containment',
+      note: '  Customer impact is stable.  ',
+    }),
+    'Lee acknowledged `Containment`: Customer impact is stable.',
+  );
+});
+
+test('preserves acknowledgement formatting without a note', () => {
   assert.equal(
     formatAcknowledgement({ member: 'Lee', decision: 'Containment' }),
     'Lee acknowledged `Containment`',
   );
+
+  assert.equal(
+    formatAcknowledgement({
+      member: 'Lee',
+      decision: 'Containment',
+      note: '   ',
+    }),
+    'Lee acknowledged `Containment`',
+  );
 });
