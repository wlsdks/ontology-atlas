{
  "name": "ontology-atlas",
  "version": "0.11.0",
  "packageManager": "pnpm@10.34.9",
  "private": true,
  "description": "Scaffold an Ontology Atlas vault and wire the checkout MCP server into the agents that will read it.",
  "type": "module",
  "main": "src/main.mjs",
  "bin": {
    "ontology-atlas": "src/main.mjs"
  },
  "scripts": {
    "test": "node --test src/*.test.mjs src/lib/*.test.mjs src/lib/*/*.test.mjs"
  },
  "files": [
    "src",
    "templates",
    "CHANGELOG.md",
    "README.md"
  ],
  "keywords": [
    "ontology",
    "codebase",
    "ai-agent",
    "mcp",
    "knowledge-graph",
    "markdown",
    "frontmatter",
    "vault",
    "obsidian-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wlsdks/ontology-atlas.git",
    "directory": "cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  }
}
