/*
 * 탐지기 프로브용 픽스처 — **일부러 하드컷인 표면.**
 *
 * `tests/contract/surface-motion-ratchet.contract.test.ts` 가 이 파일을 읽어
 * "등장/퇴장 기제가 없는 파일을 실제로 잡는가" 를 확인한다. 등록부가 0 이 된
 * 뒤로는 그 게이트가 공집합 위에서 돌기 때문에, 탐지기가 살아 있다는 증거는
 * 이 픽스처 하나뿐이다.
 *
 * 확장자가 `.fixture` 인 이유: tsc·eslint·vitest 의 시야 밖에 두려는 것이다.
 * 컴파일되는 순간 "고쳐야 할 코드" 로 오해받고, 누군가 친절하게 등장/퇴장을
 * 붙여 주면 프로브가 조용히 죽는다.
 *
 * ⚠️ **이 파일에는 인정되는 기제의 이름이 하나도 들어가면 안 된다** — 주석에도.
 * 탐지기는 소스를 문자열로 훑으므로 «쓰지 말라» 고 적은 주석조차 기제를 쓴 것으로
 * 읽힌다(첫 판이 정확히 그렇게 실패했다: 경고문에 이름을 적어서 프로브가 빨개졌다).
 * 목록은 계약 테스트의 `MOTION_MECHANISMS` 가 들고 있다.
 */
export function HardCutPanel({ open, title }: { open: boolean; title: string }) {
  return open ? <div className="panel">{title}</div> : null;
}
