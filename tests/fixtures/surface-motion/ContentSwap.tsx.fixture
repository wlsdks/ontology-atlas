/*
 * Detector probe — **things that must not be counted.**
 *
 * Places where only content changes within an already-mounted container (e.g., sections of
 * setting sheets, branches of connection sheets) are "replacements," not "appearances." In
 * reality, three places fell into this category, and the old registry required humans to
 * manually write "parent is already animating" to filter them out. The census distinguishes
 * **mechanically** by whether an alternative branch draws anything.
 *
 * If this fixture starts being counted, the discrimination logic is dead, and the census will
 * begin demanding paths to fix places that need no fixing — noise.
 */
function ProbeLeftPanel() {
  return <div className="fixed inset-0 z-50">left</div>;
}

function ProbeRightPanel() {
  return <div className="fixed inset-0 z-50">right</div>;
}

export function ContentSwapHost({ which }: { which: boolean }) {
  return <>{which ? <ProbeLeftPanel /> : <ProbeRightPanel />}</>;
}
