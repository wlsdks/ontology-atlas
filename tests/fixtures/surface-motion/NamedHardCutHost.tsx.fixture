/*
 * Detector probe — **named surface drawn conditionally by parent.**
 *
 * During the old registry era, `HardCutPanel.tsx.fixture` only needed to check "is there a
 * mechanism in the file?" After the census changed to determine at call sites, **the parent** is
 * also required for the probe to hold — so this fixture places both parent and surface in one file.
 *
 * ⚠️ No accepted mechanism names must appear — not even in comments.
 */
function ProbeSurfacePanel({ title }: { title: string }) {
  return <div className="fixed inset-0 z-50">{title}</div>;
}

export function NamedHardCutHost({ open, title }: { open: boolean; title: string }) {
  return <>{open && <ProbeSurfacePanel title={title} />}</>;
}
