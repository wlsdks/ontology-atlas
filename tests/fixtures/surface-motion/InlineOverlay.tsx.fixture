/*
 * Detector probe — **the exact shape the owner actually planted.**
 *
 * 2026-08-04: When `{open && <div className="fixed …">}` was added to a new panel file and
 * ratchet ran, it turned green. The detector, which only traverses the registry, couldn't see
 * the unnamed inline overlay at all. This fixture is resident evidence of that blind spot.
 *
 * Reason for `.fixture` extension: to keep it out of tsc·eslint·vitest's view.
 * The moment it compiles, it's mistaken as "code to fix," and someone kindly adds a path
 * to fix it, killing the probe silently.
 *
 * ⚠️ **No accepted mechanism names must appear** — not even in comments. The detector
 * scans source as text, so even comments saying "do not write" are read as using the mechanism.
 */
export function InlineOverlayHost({ open, title }: { open: boolean; title: string }) {
  return (
    <>
      {open && (
        <div role="dialog" className="fixed inset-0 z-50 bg-black">
          <p>{title}</p>
        </div>
      )}
    </>
  );
}
