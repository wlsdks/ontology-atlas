        "quantifier": "each",
        "targets": ["role:operator", "process:handoff"]
      },
      "requiredWitnessKinds": ["concept", "source_span"],
      "unknownPolicy": {
        "allowed": true,
        "response": "Expose the missing role or process owner instead of inventing one."
