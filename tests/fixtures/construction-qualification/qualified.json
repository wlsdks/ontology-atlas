    {
      "id": "cq:executive-risk",
      "scenarioId": "scenario:executive-risk",
      "audience": "executive",
      "question": "Which product outcome is at risk and what boundary contains that risk?",
      "owner": { "id": "human:product-owner", "authority": "human" },
      "revision": {
        "version": 1,
        "approvedBy": "human:product-owner",
        "approvedAt": "2026-08-09T00:00:00.000Z"
      },
      "expectedAnswer": {
        "shape": "decision",
        "quantifier": "one",
        "targets": ["outcome:preserve-trust"]
      },
      "requiredWitnessKinds": ["source_span", "relation"],
      "unknownPolicy": {
        "allowed": true,
        "response": "State that outcome risk is unknown and request current product evidence."
      },
