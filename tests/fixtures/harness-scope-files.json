{
  "files": [
    {
      "id": "claude-project",
      "tool": "claude-code",
      "scope": "project",
      "patterns": {
        "macos": "<repository>/.claude/settings.json",
        "linux": "<repository>/.claude/settings.json",
        "windows": "<repository>\\.claude\\settings.json"
      }
    },
    {
      "id": "claude-local",
      "tool": "claude-code",
      "scope": "local",
      "patterns": {
        "macos": "<repository>/.claude/settings.local.json",
        "linux": "<repository>/.claude/settings.local.json",
        "windows": "<repository>\\.claude\\settings.local.json"
      }
    },
    {
      "id": "claude-user",
      "tool": "claude-code",
      "scope": "user",
      "patterns": {
        "macos": "~/.claude/settings.json",
        "linux": "~/.claude/settings.json",
        "windows": "%USERPROFILE%\\.claude\\settings.json"
      }
    },
    {
      "id": "claude-managed",
      "tool": "claude-code",
      "scope": "managed",
      "patterns": {
        "macos": "/Library/Application Support/ClaudeCode/managed-settings.json",
        "linux": "/etc/claude-code/managed-settings.json",
        "windows": "C:\\Program Files\\ClaudeCode\\managed-settings.json"
      }
    },
    {
      "id": "codex-project",
      "tool": "codex",
      "scope": "project",
      "patterns": {
        "macos": "<repository>/.codex/hooks.json",
        "linux": "<repository>/.codex/hooks.json",
        "windows": "<repository>\\.codex\\hooks.json"
      }
    },
    {
      "id": "codex-user",
      "tool": "codex",
      "scope": "user",
      "patterns": {
        "macos": "~/.codex/hooks.json",
        "linux": "~/.codex/hooks.json",
        "windows": "%USERPROFILE%\\.codex\\hooks.json"
      }
    },
    {
      "id": "codex-system",
      "tool": "codex",
      "scope": "system",
      "patterns": {
        "macos": "/etc/codex/hooks.json",
        "linux": "/etc/codex/hooks.json",
        "windows": "%ProgramData%\\OpenAI\\Codex\\hooks.json"
      }
    },
    {
      "id": "codex-project-config",
      "tool": "codex",
      "scope": "project",
      "patterns": {
        "macos": "<repository>/.codex/config.toml",
        "linux": "<repository>/.codex/config.toml",
        "windows": "<repository>\\.codex\\config.toml"
      }
    },
    {
      "id": "codex-user-config",
      "tool": "codex",
      "scope": "user",
      "patterns": {
        "macos": "~/.codex/config.toml",
        "linux": "~/.codex/config.toml",
        "windows": "%USERPROFILE%\\.codex\\config.toml"
      }
    }
