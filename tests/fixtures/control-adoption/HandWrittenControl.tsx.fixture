/*
 * Probe fixture — **deliberately hand-written control**.
 *
 * Used solely to aim the detector in `control-adoption-ratchet.contract.test.ts`.
 * Not rendered or imported, so placed with `.fixture` extension — not subject to build, lint,
 * or type checking, and not caught by ratchet's workflow (which counts only `.tsx`).
 *
 * ⚠️ Do not "fix" this file. The moment it passes the spec check, the detector proof
 * disappears — this is not a debt but **a measuring stick**.
 */
export function HandWrittenControl() {
  return (
    <button
      type="button"
      className="inline-flex h-[33px] items-center rounded-[7px] border px-[9px] text-[13px]"
      onClick={() => undefined}
    >
      램프 밖 규격
    </button>
  );
}

/** A place where Chrome tokens own dimensions but are **not listed** — must be caught as debt. */
export function UnregisteredChromeTokenControl() {
  return (
    <button type="button" className="h-[var(--overlay-close-size)] w-[var(--overlay-close-size)]">
      닫기
    </button>
  );
}

/**
 * **Anchor control** — came into this gate's view on 2026-08-04.
 *
 * Until then, ratchet counted only `<button>`. Controls are not just `<button>`; there were
 * **109** hand-spec'd `<Link>`·`<a>` elements that the gate had never seen. The two below
 * are measuring sticks of that class.
 */
export function HandWrittenAnchorControl() {
  return (
    <Link href="/topology" className="inline-flex h-[33px] items-center rounded-[7px] px-[9px] text-[13px]">
      램프 밖 앵커
    </Link>
  );
}

export function HandWrittenExternalAnchor() {
  return (
    <a href="https://example.com" className="inline-flex h-[29px] items-center rounded-[5px] px-[7px]">
      램프 밖 외부 앵커
    </a>
  );
}
