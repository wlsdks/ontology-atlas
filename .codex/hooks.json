{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/block-npm-publish.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-unsafe-git.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-secret-read.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-manual-landing.sh"
          }
        ]
      },
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/block-npm-publish.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-unsafe-git.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-secret-read.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-manual-landing.sh"
          }
        ]
      },
      {
        "matcher": "functions.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/block-npm-publish.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-unsafe-git.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-secret-read.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-manual-landing.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/block-generated-edit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/inject-ontology-summary.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/fast-sensor.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/stamp-verification.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/record-usage.sh"
          }
        ]
      },
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/stamp-verification.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/record-usage.sh"
          }
        ]
      },
      {
        "matcher": "functions.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/stamp-verification.sh"
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/record-usage.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/remind-verify-on-stop.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/record-usage.sh"
          }
        ]
      }
    ]
  }
}
