# Local MCP and agent state
.serena/
# CodeGraph index; its daemon.sock crashes Tailwind source scanning.
.codegraph/
.ontology-atlas/
docs/ontology/.ontology-atlas/

# Claude Code: commit shared instructions, never personal or local state
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory-local/
.claude/cache/
.claude/local/
.claude/scheduled_tasks.lock
.claude/worktrees/
/.claude/shots-*/

# Dependencies
node_modules/

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
src-tauri/target/
src-tauri/gen/
# `pnpm mcp:build-binary` output, about 59MB
src-tauri/binaries/
release-upload/
release-assets/

# Generated per worktree by install, checkout, merge and build
/src/entities/docs-vault/data/
/public/docs-vault/
# Message composites; the authored parts are messages/<locale>/<Namespace>.json.
/messages/*.json
/messages/*.tmp

# Secrets. Every .env name is listed: secret-read-guard.contract.test.ts reads
# them to prove .claude/settings.json denies reading each one.
.env
.env.local
.env.prod
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env.staging
.env*
!.env.example
*.pem
*.p8
*.p12
*.key
.local-credentials/
# Written by CLI tests that run `agent-setup`; holds this machine's absolute paths.
cli/.mcp.json.example

# OS and editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

