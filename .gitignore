# Serena MCP project cache + memories (personal environment)
.serena/

# CodeGraph MCP local index (sqlite db + live socket) — do not commit.
# Ignoring is essential to prevent Tailwind v4 source scanning from crashing when reading daemon.sock.
.codegraph/

# Ontology Atlas local runtime state (agent heartbeat, UI session files).
.ontology-atlas/
docs/ontology/.ontology-atlas/

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
build/
dist/

# Tauri / Rust desktop build output
src-tauri/target/
src-tauri/gen/
# Compiled MCP server binaries (app bundle payload, ~59MB) — build output, not source
# Created by `pnpm mcp:build-binary`.
src-tauri/binaries/

# Production
*.tsbuildinfo
next-env.d.ts
.firebase/

# Environment variables
.env
.env.local
.env.prod
.env.development.local
.env.test.local
.env.production.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# External references (cloned separately, not part of this repo)
references/

# Playwright MCP session dumps (snapshot yaml · screenshots)
.playwright-mcp/
*.png
!public/logo.png
!docs/assets/readme/*.png
!public/og-image.png
!public/brand-icon-512.png
!app/apple-icon.png
!app/icon.png
!assets/brand/mascot/*.png
!public/brand/*.png
!src-tauri/icons/
!src-tauri/icons/**
!docs/prototypes/shots/
!docs/prototypes/shots/**
# Demo clip poster — the first frame of the video, so it must be held in the repository. The global `*.png`
# ignore is intended to block Playwright dumps, not deployment assets
# (an exception of the same class as the brand assets above).
!public/demo/*.png

# Testing
coverage/
.nyc_output/
output/

# Temporary
*.tmp
.tmp/
.cache/

# Claude Code — ignore only local personal state. Shared guidelines are committed.
.claude/settings.local.json
.claude/cache/
.claude/local/
.claude/scheduled_tasks.lock

# Local operational credentials. Never commit.
.local-credentials/

# Screenshots for session validation (do not commit)
.screenshots/
.qa-scratch/

# Release staging output — created by CI and consumed within CI. Running
# stage-macos-release-assets.mjs locally generates files here.
release-upload/
release-assets/

# Output dropped into the checkout by CLI tests running `agent-setup` for real.
# Contains absolute paths to temporary vaults; if committed, **that machine's path becomes embedded in the repository** — this actually happened once (2026-07-29).
cli/.mcp.json.example

# QA sweep output — thousands of screenshots accumulate at the root during audits (measurement on 2026-07-31:
# `sweep-2026-07-28` 3.3M · `sweepA2` 11M). Knowledge remains in `.qa-scratch/*.md`,
# but images are not kept.
sweep*/

# Agent worktree — lives inside the repository but is not part of it.
# (2026-08-03: `git add -A` once committed this as a gitlink into main)
.claude/worktrees/
